{
	"name": "n8n-nodes-empiriolabs",
	"version": "0.4.0",
	"description": "n8n nodes for EmpirioLabs AI: chat, image generation, editing and analysis, text to speech, music and sound generation, transcription, video generation, 3D generation, embeddings, reranking, decisions, AI text detection, document reading (OCR), web search and research, and async jobs.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://empiriolabs.ai",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"empiriolabs",
		"ai",
		"llm",
		"image-generation",
		"image-editing",
		"image-analysis",
		"video-generation",
		"3d-generation",
		"text-to-speech",
		"music-generation",
		"transcription",
		"embeddings",
		"reranking",
		"decisions",
		"ai-detection",
		"ocr",
		"web-search",
		"research"
	],
	"author": {
		"name": "EmpirioLabs AI",
		"email": "support@empiriolabs.ai",
		"url": "https://empiriolabs.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EmpirioLabs-AI/n8n-nodes-empiriolabs.git"
	},
	"bugs": {
		"url": "https://github.com/EmpirioLabs-AI/n8n-nodes-empiriolabs/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/unit/*.test.mjs",
		"test:live": "npm run build && node --test test/live/*.test.mjs",
		"scan:local": "npm run build && node scripts/scan-local.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/docs",
		"!dist/test"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/EmpirioLabsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Empiriolabs/Empiriolabs.node.js",
			"dist/nodes/EmpiriolabsTrigger/EmpiriolabsTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.2",
		"eslint": "9.32.0",
		"prettier": "3.10.1",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
